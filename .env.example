# ====================================================================
# STUDIO Comp CTF Writeup Vault - Environment Configuration
# Duplicate this file as '.env' and fill in your credentials.
# NOTE: Never commit your actual '.env' file to Git!
# ====================================================================

# --------------------------------------------------------------------
# 1. Supabase (Database for CTF Flags & Keep-Alive Ping)
# Get these from: Supabase Dashboard -> Project Settings -> API
# --------------------------------------------------------------------
PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Used by the CLI tool (pnpm flag:set) to securely write flags into Supabase
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# --------------------------------------------------------------------
# 2. Cloudflare R2 (Object Storage for Screenshot Images)
# Get these from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# --------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="ctf-writeup-assets"

# Public URL or Custom Domain pointing to your R2 bucket (e.g., https://pub-xxx.r2.dev or https://cdn.yourdomain.com)
PUBLIC_R2_CUSTOM_DOMAIN="https://pub-your-bucket-id.r2.dev"
