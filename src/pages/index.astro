---
import BaseLayout from '@layouts/BaseLayout.astro';
import { VaultApp } from '@components/islands/VaultApp';
import { getWriteups } from '@features/writeups/lib/get-writeups';

const displayWriteups = await getWriteups();
---

<BaseLayout
  title="auka-ctf-blog | AUKA CTF Writeup Vault"
  description="Comprehensive CTF writeup repository and offensive security archives from AUKA CTF."
>
  <VaultApp client:load initialWriteups={displayWriteups} />
</BaseLayout>
